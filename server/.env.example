# Contact service settings. Copy to server/.env for local work, or to /etc/kristijankresic/contact.env on the VPS.
# Resend API key with "Sending access" only.
RESEND_API_KEY=re_replace_me
# Where messages are delivered.
CONTACT_TO=you@example.com
# Sender on a domain verified at Resend.
CONTACT_FROM=Website <contact@example.com>
# The site origin allowed to post. Locally: http://localhost:3000
# If the site answers on more than one address, list them: https://example.com,https://www.example.com
CONTACT_ORIGIN=https://example.com
# Local port the service listens on (127.0.0.1 only).
CONTACT_PORT=8787
# Only when a managed platform (not nginx on this machine) is in front: listen on all interfaces, and name the header
# that platform sets to the visitor's address, so the rate limit counts real visitors.
# CONTACT_HOST=0.0.0.0
# CONTACT_IP_HEADER=do-connecting-ip
# Local work only: 1 answers as if sent and never calls Resend, so no key is needed. Refused unless CONTACT_ORIGIN is localhost.
# CONTACT_DRY_RUN=1
