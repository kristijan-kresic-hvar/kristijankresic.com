# Contact service settings. Copy to server/.env for local work, or to /etc/kristijankresic/contact.env on the VPS.
# Resend API key with "Sending access" only.
RESEND_API_KEY=re_replace_me
# Where messages are delivered.
CONTACT_TO=you@example.com
# Sender on a domain verified at Resend.
CONTACT_FROM=Website <contact@example.com>
# The site origin allowed to post. Locally: http://localhost:3000
CONTACT_ORIGIN=https://example.com
# Local port the service listens on (127.0.0.1 only).
CONTACT_PORT=8787
